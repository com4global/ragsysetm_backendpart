# ⚠️ IMPORTANT: This is an EXAMPLE file - DO NOT use these keys!
# Copy this file to .env and fill in your real API keys
# .env should NEVER be committed to GitHub

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-key-here-do-not-share

# Pinecone API Key (get from https://www.pinecone.io)
PINECONE_API_KEY=pcaxxxxxxxx-your-key-here

# Pinecone Index Name (the vector database index)
PINECONE_INDEX_NAME=hr-assistant-index

# Optional: Frontend Base URL (for CORS)
FRONTEND_URL=http://localhost:3000
