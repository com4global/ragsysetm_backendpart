# Environment files
.env
frontend/.env
.myenvironment/
.menv/
*.venv/
venv/
ENV/
env/

# Python cache and bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
*.python-version

# Virtual environment
.myenv/
.menv/
venv/
*.venv/

# Generated / cached audio files (re-created at runtime)
static/tts_audio/
*.mp3

# Uploaded & processed user files (runtime data, not source code)
uploads/
processed/
resources/*/
!resources/

# User database (local dev only)
users.db
*.db

# Resources, data, or temp files
*.log
*.tmp

# OS specific
.DS_Store
Thumbs.db

# IDE/editor configs
.vscode/
.idea/
.vs/
*.swp

# Node modules
node_modules/
frontend/node_modules/

# Ignore all video formats
*.mp4
*.mov
*.wmv
*.avi
*.mkv
*.flv
